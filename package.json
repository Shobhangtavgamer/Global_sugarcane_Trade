{
  "name": "sugartrade-global-website",
  "version": "1.0.0",
  "private": true,
  "description": "Professional import/export business website for SugarTrade Global - Premium sugarcane trading platform",
  "author": {
    "name": "SugarTrade Global Pvt. Ltd.",
    "email": "info@sugartradeglobal.com",
    "url": "https://www.sugartradeglobal.com"
  },
  "keywords": [
    "sugarcane",
    "import",
    "export",
    "agriculture",
    "trade",
    "business",
    "global",
    "sugar",
    "jaggery",
    "farming",
    "international"
  ],
  "homepage": "https://www.sugartradeglobal.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/sugartradeglobal/website.git"
  },
  "bugs": {
    "url": "https://github.com/sugartradeglobal/website/issues",
    "email": "support@sugartradeglobal.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.2",
    "axios": "^1.3.4",
    "framer-motion": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-hot-toast": "^2.4.0",
    "react-icons": "^4.8.0",
    "react-intersection-observer": "^9.4.3",
    "react-router-dom": "^6.8.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^3.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.10.11",
    "cross-env": "^7.0.3",
    "eslint": "^8.36.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "serve": "^14.2.0",
    "tailwindcss": "^3.2.7"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/**/*.{js,jsx} --quiet --fix",
    "lint:check": "eslint src/**/*.{js,jsx}",
    "format": "prettier --write src/**/*.{js,jsx,css,md,json}",
    "format:check": "prettier --check src/**/*.{js,jsx,css,md,json}",
    "analyze": "npm run build && npx serve -s build",
    "predeploy": "npm run build",
    "deploy": "npm run build && npm run serve:build",
    "serve:build": "serve -s build -l 3000",
    "clean": "rm -rf build node_modules package-lock.json",
    "reinstall": "npm run clean && npm install",
    "dev": "cross-env NODE_ENV=development npm start",
    "prod": "cross-env NODE_ENV=production npm run build",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint:check && npm run format:check && npm run test -- --coverage --watchAll=false"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-console": "warn",
      "no-unused-vars": "warn",
      "react/prop-types": "off",
      "jsx-a11y/anchor-is-valid": "off"
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/**/*.test.{js,jsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "proxy": "https://api.sugartradeglobal.com",
  "metadata": {
    "title": "SugarTrade Global - Import Export Business",
    "description": "Professional sugarcane import/export business platform",
    "industry": "Agriculture & International Trade",
    "founded": "2010",
    "headquarters": "Indapur, Maharashtra, India",
    "specialties": [
      "Sugarcane Export",
      "Raw Sugar Trading",
      "Jaggery Production",
      "International Shipping",
      "Agricultural Consulting",
      "Quality Assurance"
    ],
    "markets": [
      "North America",
      "Europe",
      "Middle East",
      "Southeast Asia",
      "Africa"
    ],
    "certifications": [
      "ISO 9001:2015",
      "HACCP Certified",
      "Organic Certified",
      "Export License",
      "FSSAI Approved"
    ]
  },
  "performance": {
    "budgets": [
      {
        "type": "initial",
        "maximumWarning": "2mb",
        "maximumError": "5mb"
      },
      {
        "type": "anyComponentStyle",
        "maximumWarning": "150kb"
      }
    ]
  },
  "seo": {
    "sitemap": true,
    "robots": true,
    "manifest": true,
    "analytics": {
      "google": "GA_MEASUREMENT_ID",
      "facebook": "FB_PIXEL_ID"
    },
    "structured_data": true,
    "open_graph": true,
    "twitter_card": true
  }
}
